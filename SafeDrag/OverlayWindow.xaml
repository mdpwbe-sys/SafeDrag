<Window x:Class="SafeExplorer.Tray.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SafeDrag Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Border x:Name="OverlayBorder"
            Background="#65991B1B"
            CornerRadius="12"
            Padding="10,4"
            BorderBrush="#A0EF4444"
            BorderThickness="1.2">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Color="#40000000" Opacity="0.3"/>
        </Border.Effect>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="StatusIcon"
                       Text="🔒"
                       FontSize="13"
                       Margin="0,0,6,0"
                       VerticalAlignment="Center"/>
            <TextBlock x:Name="StatusText"
                       Text="Clic droit pour autoriser"
                       Foreground="#FFFFFF"
                       FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
                       FontSize="11.5"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
        </StackPanel>
    </Border>
</Window>
